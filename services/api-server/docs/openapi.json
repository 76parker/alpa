  "components": {
    "parameters": {
      "WorkspaceID": {
        "name": "workspace_id",
        "in": "path",
        "required": true,
        "schema": {
          "allOf": [
            {
              "$ref": "#/components/schemas/ID"
            }
          ],
          "example": 1001
        }
      },
      "ProductID": {
        "name": "product_id",
        "in": "path",
        "required": true,
        "schema": {
          "allOf": [
            {
              "$ref": "#/components/schemas/ID"
            }
          ],
          "example": 2001
        }
      },
      "ComponentID": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "allOf": [
            {
              "$ref": "#/components/schemas/ID"
            }
          ],
          "example": 3001
        }
      },
      "ParentComponentID": {
        "name": "component_id",
        "in": "path",
        "required": true,
        "schema": {
          "allOf": [
            {
              "$ref": "#/components/schemas/ID"
            }
          ],
          "example": 3001
        }
      },
      "APIID": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "allOf": [
            {
              "$ref": "#/components/schemas/ID"
            }
          ],
          "example": 4001
        }
      },
      "ClientID": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "allOf": [
            {
              "$ref": "#/components/schemas/ID"
            }
          ],
          "example": 5001
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20,
          "example": 20
        }
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "example": 0
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflicting resource state",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "ID": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "example": 1001
      },
      "ProductCode": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10,
        "pattern": "^[A-Z]+$",
        "example": "CHECKOUT"
      },
      "Name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9 ._()@+:/#&',%\\[\\]-]+$",
        "example": "Payments Platform"
      },
      "Description": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000,
        "pattern": "^[A-Za-z0-9 ._()@+:/#&',%\\[\\]-]+$",
        "example": "Processes card payments and refunds."
      },
      "Pagination": {
        "type": "object",
        "required": [
          "limit",
          "offset"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "example": 20
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "example": 0
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "message",
          "code",
          "status"
        ],
        "properties": {
          "message": {
            "type": "string",
            "example": "name contains unsupported characters"
          },
          "code": {
            "type": "string",
            "description": "Business errors include unknown_language, unknown_technology_name, unknown_technology_type, too_many_endpoints, invalid_criticality, invalid_importancy, invalid_product_code, api_limit_exceeded, client_limit_exceeded, client_action_too_large, client_capabilities_too_large, invalid_client_binding, and client_already_bound. Transport errors use invalid_request.",
            "example": "invalid_request"
          },
          "status": {
            "type": "integer",
            "example": 400
          }
        }
      },
      "Workspace": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ID"
              }
            ],
            "example": 1001
          },
          "name": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Name"
              }
            ],
            "example": "Payments Platform"
          }
        }
      },
      "CreateWorkspaceRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Name"
              }
            ],
            "example": "Payments Platform"
          }
        }
      },
      "WorkspaceList": {
        "type": "object",
        "required": [
          "data",
          "pagination"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Workspace"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "Criticality": {
        "type": "string",
        "maxLength": 50,
        "enum": [
          "mission-critical",
          "business-critical",
          "business-operational",
          "office-productivity"
        ],
        "example": "business-critical"
      },
      "Product": {
        "type": "object",
        "required": [
          "id",
          "workspace_id",
          "owning_team_id",
          "product_code",
          "name",
          "criticality",
          "description"
        ],
        "properties": {
          "id": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ID"
              }
            ],
            "example": 2001
          },
          "workspace_id": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ID"
              }
            ],
            "example": 1001
          },
          "owning_team_id": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ID"
              }
            ],
            "nullable": true,
            "example": 301
          },
          "product_code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ProductCode"
              }
            ],
            "example": "CHECKOUT"
          },
          "name": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Name"
              }
            ],
            "example": "Checkout Service"
          },
          "criticality": {
            "$ref": "#/components/schemas/Criticality"
          },
          "description": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Description"
              }
            ],
