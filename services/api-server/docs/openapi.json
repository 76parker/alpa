  "openapi": "3.0.3",
  "info": {
    "title": "ALPA Inventory API",
    "version": "1.0.0",
        "description": "API for maintaining workspaces, products, and components. Input strings are trimmed; programming language values are normalized to lowercase. Business validation returns domain error codes; JSON, length, and character validation returns invalid_request."
  },
