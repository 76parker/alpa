{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": { "$ref": "#/$defs/string" }
  },
  "$defs": {
    "string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^[A-Za-z0-9 ._()@+:/#&',%\\[\\]-]+$"
    }
  }
}
