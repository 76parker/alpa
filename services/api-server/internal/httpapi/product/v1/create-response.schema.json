{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "workspace_id", "owning_team_id", "name", "criticality", "description"],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "workspace_id": { "type": "integer", "minimum": 1 },
    "owning_team_id": { "type": ["integer", "null"], "minimum": 1 },
    "name": { "type": "string" },
    "criticality": {
      "enum": ["mission-critical", "business-critical", "business-operational", "office-productivity"]
    },
    "description": { "type": ["string", "null"] }
  }
}
