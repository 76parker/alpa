{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "api_type", "network_exposure", "documentation_url"],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "name": { "type": "string" },
    "api_type": { "type": "string" },
    "network_exposure": { "type": "string" },
    "documentation_url": { "type": ["string", "null"], "format": "uri", "maxLength": 2048 }
  }
}
