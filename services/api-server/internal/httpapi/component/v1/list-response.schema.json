{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "pagination"
  ],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "pagination": {
      "$ref": "#/$defs/pagination"
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "product_id",
        "name",
        "type",
        "description",
        "details",
        "apis",
        "clients"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "product_id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "maxLength": 50,
          "enum": [
            "backend-service",
            "frontend-service",
            "infrastructure"
          ]
        },
        "description": {
          "type": "string"
        },
        "details": {
          "type": "object"
        },
        "apis": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/api"
          }
        },
        "clients": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/client"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "type": "string",
                "maxLength": 50,
                "enum": [
                  "backend-service",
                  "frontend-service"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "$ref": "#/$defs/service"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "infrastructure"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "$ref": "#/$defs/infrastructure"
              }
            }
          }
        }
      ]
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "api_type",
        "network_exposure"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "api_type": {
          "type": "string",
          "maxLength": 50,
          "enum": [
            "rest",
            "graphql",
            "grpc",
            "json-rpc",
            "soap",
            "websocket",
            "odata",
            "sse",
            "event-consumer",
            "topic",
            "exchange",
            "queue",
            "native-protocol"
          ]
        },
        "network_exposure": {
          "type": "string",
          "maxLength": 50,
          "enum": [
            "internal",
            "internet"
          ]
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "client_name",
        "role",
        "communication_type",
        "description",
        "api_id"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "client_name": {
          "type": "string",
          "maxLength": 50,
          "enum": [
            "s3-client",
            "rest-client",
            "graphql-client",
            "grpc-client",
            "json-rpc-client",
            "soap-client",
            "websocket-client",
            "odata-client",
            "sse-client",
            "kafka-client",
            "rabbitmq-client",
            "amqp-client",
            "redpanda-client",
            "nats-client",
            "pulsar-client",
            "sqs-client",
            "gcp-pub-sub-client",
            "azure-service-bus-client",
            "redis-streams-client",
            "activemq-client",
            "ibm-mq-client",
            "native-protocol-client"
          ]
        },
        "role": {
          "type": "string",
          "maxLength": 50,
          "enum": ["listener", "caller", "producer", "consumer"]
        },
        "communication_type": {
          "type": "string",
          "maxLength": 50,
          "enum": ["request-response", "polling", "long-polling", "events", "stream"]
        },
        "description": {
          "type": "string"
        },
        "api_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "language_version",
        "framework"
      ],
      "properties": {
        "language": {
          "type": "string"
        },
        "language_version": {
          "type": "string"
        },
        "framework": {
          "type": "string"
        }
      }
    },
    "infrastructure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technology",
        "system_type",
        "version",
        "endpoints"
      ],
      "properties": {
        "technology": {
          "type": "string",
          "maxLength": 50,
          "enum": [
            "postgresql",
            "mysql",
            "mariadb",
            "mongodb",
            "cassandra",
            "clickhouse",
            "redis",
            "memcached",
            "etcd",
            "kafka",
            "rabbitmq",
            "nats",
            "pulsar",
            "elasticsearch",
            "opensearch",
            "s3",
            "minio",
            "ceph",
            "temporal",
            "airflow",
            "argo-workflows",
            "nginx",
            "envoy",
            "kong",
            "traefik",
            "haproxy",
            "prometheus",
            "grafana",
            "zabbix",
            "jaeger",
            "zipkin",
            "opentelemetry",
            "keycloak",
            "vault"
          ]
        },
        "system_type": {
          "type": "string",
          "maxLength": 50,
          "enum": [
            "message-broker",
            "sql-database",
            "nosql-database",
            "cache",
            "search-engine",
            "object-storage",
            "workflow-engine",
            "service-mesh",
            "api-gateway",
            "load-balancer",
            "identity-provider",
            "secret-storage",
            "monitoring",
            "logging",
            "tracing"
          ]
        },
        "version": {
          "type": "string"
        },
        "endpoints": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "^[A-Za-z0-9 ._()@+:/#&',%\\[\\]-]+$"
          }
        }
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit",
        "offset"
      ],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
