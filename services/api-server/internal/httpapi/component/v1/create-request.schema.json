{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["product_id", "name", "type", "details"],
  "properties": {
    "product_id": { "type": "integer", "minimum": 1 },
    "name": { "$ref": "#/$defs/string" },
    "type": { "type": "string", "maxLength": 50, "enum": ["backend-service", "frontend-service", "infrastructure"] },
    "description": { "$ref": "#/$defs/description" },
    "details": { "type": "object" },
    "apis": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/createAPI" } },
    "clients": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/createClient" } }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "backend-service" } }, "required": ["type"] }, "then": { "properties": { "details": { "$ref": "#/$defs/service" } } } },
    { "if": { "properties": { "type": { "const": "frontend-service" } }, "required": ["type"] }, "then": { "properties": { "details": { "$ref": "#/$defs/service" } } } },
    { "if": { "properties": { "type": { "const": "infrastructure" } }, "required": ["type"] }, "then": { "properties": { "details": { "$ref": "#/$defs/infrastructure" } } } }
  ],
  "$defs": {
    "string": { "type": "string", "minLength": 1, "maxLength": 50, "pattern": "^[A-Za-z0-9 ._()@+:/#&',%\\[\\]-]+$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^[A-Za-z0-9 ._()@+:/#&',%\\[\\]-]+$" },
    "service": { "type": "object", "additionalProperties": false, "required": ["language"], "properties": { "language": { "$ref": "#/$defs/string" }, "language_version": { "$ref": "#/$defs/string" }, "framework": { "$ref": "#/$defs/string" } } },
    "infrastructure": { "type": "object", "additionalProperties": false, "required": ["technology", "system_type"], "properties": { "technology": { "type": "string", "maxLength": 50, "enum": ["postgresql", "mysql", "mariadb", "mongodb", "cassandra", "clickhouse", "redis", "memcached", "etcd", "kafka", "rabbitmq", "nats", "pulsar", "elasticsearch", "opensearch", "s3", "minio", "ceph", "temporal", "airflow", "argo-workflows", "nginx", "envoy", "kong", "traefik", "haproxy", "prometheus", "grafana", "zabbix", "jaeger", "zipkin", "opentelemetry", "keycloak", "vault"] }, "system_type": {"type": "string", "maxLength": 50, "enum": ["message-broker", "sql-database", "nosql-database", "cache", "search-engine", "object-storage", "workflow-engine", "service-mesh", "api-gateway", "load-balancer", "identity-provider", "secret-storage", "monitoring", "logging", "tracing"]}, "version": { "$ref": "#/$defs/string" }, "endpoints": {"type": ["array", "null"], "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 50, "pattern": "^[A-Za-z0-9 ._()@+:/#&',%\\[\\]-]+$"}} } },
    "createAPI": { "type": "object", "additionalProperties": false, "required": ["name", "api_type", "network_exposure"], "properties": { "name": { "$ref": "#/$defs/string" }, "api_type": { "type": "string", "maxLength": 50, "enum": ["rest", "graphql", "grpc", "json-rpc", "soap", "websocket", "odata", "sse", "event-consumer", "topic", "exchange", "queue", "native-protocol"] }, "network_exposure": { "type": "string", "maxLength": 50, "enum": ["internal", "internet"] } } },
    "createClient": { "type": "object", "additionalProperties": false, "required": ["client_name", "role", "communication_type"], "properties": { "client_name": { "type": "string", "maxLength": 50, "enum": ["s3-client", "rest-client", "graphql-client", "grpc-client", "json-rpc-client", "soap-client", "websocket-client", "odata-client", "sse-client", "kafka-client", "rabbitmq-client", "amqp-client", "redpanda-client", "nats-client", "pulsar-client", "sqs-client", "gcp-pub-sub-client", "azure-service-bus-client", "redis-streams-client", "activemq-client", "ibm-mq-client", "native-protocol-client"] }, "role": { "type": "string", "maxLength": 50, "enum": ["listener", "caller", "producer", "consumer"] }, "communication_type": { "type": "string", "maxLength": 50, "enum": ["request-response", "polling", "long-polling", "events", "stream"] }, "description": { "$ref": "#/$defs/description" } } }
  }
}
