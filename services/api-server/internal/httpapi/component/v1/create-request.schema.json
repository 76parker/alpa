{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["product_id", "name", "type", "details"],
  "properties": {
    "product_id": { "type": "integer", "minimum": 1 },
    "name": { "$ref": "#/$defs/string" },
    "type": { "enum": ["Backend Service", "Frontend Service", "Infrastructure", "Background Worker"] },
    "description": { "$ref": "#/$defs/description" },
    "details": { "type": "object" },
    "apis": {
      "type": "array",
      "items": { "$ref": "#/$defs/api" }
    }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "Backend Service" } }, "required": ["type"] }, "then": { "properties": { "details": { "$ref": "#/$defs/service" } } } },
    { "if": { "properties": { "type": { "const": "Frontend Service" } }, "required": ["type"] }, "then": { "properties": { "details": { "$ref": "#/$defs/service" } } } },
    { "if": { "properties": { "type": { "const": "Infrastructure" } }, "required": ["type"] }, "then": { "properties": { "details": { "$ref": "#/$defs/infrastructure" } } } },
    { "if": { "properties": { "type": { "const": "Background Worker" } }, "required": ["type"] }, "then": { "properties": { "details": { "$ref": "#/$defs/backgroundWorker" } } } }
  ],
  "$defs": {
    "string": { "type": "string", "minLength": 1, "maxLength": 50, "pattern": "^[A-Za-z0-9 ._()@+:/#&',%\\[\\]-]+$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^[A-Za-z0-9 ._()@+:/#&',%\\[\\]-]+$" },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "api_type", "network_exposure"],
      "properties": {
        "name": { "$ref": "#/$defs/string" },
        "api_type": { "enum": ["REST", "GraphQL", "gRPC", "JSON-RPC", "SOAP", "WebSocket", "OData", "SSE", "Event", "Native Protocol"] },
        "network_exposure": { "enum": ["internal", "internet"] }
      }
    },
    "service": { "type": "object", "additionalProperties": false, "required": ["language"], "properties": { "language": { "$ref": "#/$defs/string" }, "language_version": { "$ref": "#/$defs/string" }, "framework": { "$ref": "#/$defs/string" } } },
    "backgroundWorker": { "type": "object", "additionalProperties": false, "required": ["language", "broker"], "properties": { "language": { "$ref": "#/$defs/string" }, "language_version": { "$ref": "#/$defs/string" }, "framework": { "$ref": "#/$defs/string" }, "broker": { "enum": ["RabbitMQ", "Kafka", "Redpanda", "NATS/JetStream", "Apache Pulsar", "AWS SQS", "Google Cloud Pub/Sub", "Azure Service Bus", "Redis Streams", "ActiveMQ", "IBM MQ"] } } },
    "infrastructure": { "type": "object", "additionalProperties": false, "required": ["system"], "properties": { "system": { "$ref": "#/$defs/string" }, "version": { "$ref": "#/$defs/string" }, "network_address": { "$ref": "#/$defs/string" } } }
  }
}
