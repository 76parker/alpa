{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product_id",
    "name",
    "type",
    "details"
  ],
  "properties": {
    "product_id": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "$ref": "#/$defs/string"
    },
    "type": {
      "type": "string",
      "maxLength": 50,
      "enum": [
        "backend-service",
        "frontend-service",
        "infrastructure"
      ]
    },
    "description": {
      "$ref": "#/$defs/description"
    },
    "details": {
      "type": "object"
    },
    "apis": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/createAPI"
      }
    },
    "clients": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/createClient"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "backend-service"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "details": {
            "$ref": "#/$defs/backendService"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "frontend-service"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "details": {
            "$ref": "#/$defs/frontendService"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "infrastructure"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "details": {
            "$ref": "#/$defs/infrastructure"
          }
        }
      }
    }
  ],
  "$defs": {
    "string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "backendService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language"
      ],
      "properties": {
        "language": {
          "type": "string",
          "enum": [
            "c",
            "c++",
            "c#",
            "go",
            "java",
            "javascript",
            "typescript",
            "python",
            "ruby",
            "php",
            "rust",
            "swift",
            "kotlin",
            "scala",
            "dart",
            "lua",
            "perl",
            "r",
            "objective-c",
            "shell",
            "bash",
            "powershell",
            "sql",
            "solidity",
            "haskell",
            "elixir",
            "erlang",
            "clojure",
            "groovy",
            "fortran",
            "cobol",
            "assembly",
            "visual-basic",
            "matlab",
            "pascal",
            "delphi",
            "f#",
            "julia",
            "zig",
            "nim",
            "ocaml",
            "prolog",
            "common-lisp",
            "scratch"
          ]
        },
        "repository_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "frontendService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language"
      ],
      "properties": {
        "language": {
          "type": "string",
          "enum": [
            "c",
            "c++",
            "c#",
            "go",
            "java",
            "javascript",
            "typescript",
            "python",
            "ruby",
            "php",
            "rust",
            "swift",
            "kotlin",
            "scala",
            "dart",
            "lua",
            "perl",
            "r",
            "objective-c",
            "shell",
            "bash",
            "powershell",
            "sql",
            "solidity",
            "haskell",
            "elixir",
            "erlang",
            "clojure",
            "groovy",
            "fortran",
            "cobol",
            "assembly",
            "visual-basic",
            "matlab",
            "pascal",
            "delphi",
            "f#",
            "julia",
            "zig",
            "nim",
            "ocaml",
            "prolog",
            "common-lisp",
            "scratch"
          ]
        },
        "language_version": {
          "$ref": "#/$defs/string"
        },
        "framework": {
          "$ref": "#/$defs/string"
        }
      }
    },
    "infrastructure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technology_name",
        "technology_type",
        "importancy"
      ],
      "properties": {
        "technology_name": {
          "type": "string",
          "maxLength": 50,
          "enum": [
            "postgresql",
            "mysql",
            "mariadb",
            "mongodb",
            "cassandra",
            "clickhouse",
            "redis",
            "memcached",
            "etcd",
            "kafka",
            "rabbitmq",
            "nats",
            "pulsar",
            "elasticsearch",
            "opensearch",
            "s3",
            "minio",
            "ceph",
            "temporal",
            "airflow",
            "argo-workflows",
            "nginx",
            "envoy",
            "kong",
            "traefik",
            "haproxy",
            "prometheus",
            "grafana",
            "zabbix",
            "jaeger",
            "zipkin",
            "opentelemetry",
            "keycloak",
            "vault"
          ]
        },
        "technology_type": {
          "type": "string",
          "maxLength": 50,
          "enum": [
            "message-broker",
            "sql-database",
            "nosql-database",
            "cache",
            "search-engine",
            "object-storage",
            "workflow-engine",
            "service-mesh",
            "api-gateway",
            "load-balancer",
            "identity-provider",
            "secret-storage",
            "monitoring",
            "logging",
            "tracing"
          ]
        },
        "importancy": {
          "type": "string",
          "enum": [
            "critical",
            "important",
            "supporting"
          ]
        },
        "version": {
          "$ref": "#/$defs/string"
        },
        "endpoints": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          }
        }
      }
    },
    "createAPI": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "api_type",
        "network_exposure"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Required API name with up to 20 non-whitespace characters; surrounding whitespace is trimmed.",
          "pattern": "^(?=\\s*\\S)(?:\\s*\\S){1,20}\\s*$"
        },
        "api_type": {
          "type": "string",
          "maxLength": 50,
          "enum": [
            "rest",
            "graphql",
            "grpc",
            "json-rpc",
            "soap",
            "websocket",
            "odata",
            "sse",
            "event-consumer",
            "topic",
            "subject",
            "exchange",
            "queue",
            "native-protocol",
            "database"
          ]
        },
        "network_exposure": {
          "type": "string",
          "maxLength": 50,
          "enum": [
            "internal",
            "internet"
          ]
        }
      }
    },
    "createClient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_name"
      ],
      "properties": {
        "client_name": {
          "type": "string",
          "maxLength": 50,
          "enum": [
            "s3-client",
            "rest-client",
            "graphql-client",
            "grpc-client",
            "grpc-streaming-client",
            "json-rpc-client",
            "soap-client",
            "websocket-client",
            "odata-client",
            "sse-client",
            "kafka-client",
            "rabbitmq-client",
            "amqp-client",
            "redpanda-client",
            "nats-client",
            "pulsar-client",
            "sqs-client",
            "gcp-pub-sub-client",
            "azure-service-bus-client",
            "redis-streams-client",
            "activemq-client",
            "ibm-mq-client",
            "native-protocol-client"
          ]
        },
        "capabilities": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2097152
        },
        "secure_connection": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
