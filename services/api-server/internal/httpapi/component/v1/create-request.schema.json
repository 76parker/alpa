{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["product_id", "name", "type", "details"],
  "properties": {
    "product_id": { "type": "integer", "minimum": 1 },
    "name": { "$ref": "#/$defs/string" },
    "type": { "type": "string", "maxLength": 50, "enum": ["backend-service", "frontend-service", "infrastructure", "background-worker"] },
    "description": { "$ref": "#/$defs/description" },
    "details": { "type": "object" },
    "apis": {
      "type": "array",
      "items": { "$ref": "#/$defs/api" }
    }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "backend-service" } }, "required": ["type"] }, "then": { "properties": { "details": { "$ref": "#/$defs/service" } } } },
    { "if": { "properties": { "type": { "const": "frontend-service" } }, "required": ["type"] }, "then": { "properties": { "details": { "$ref": "#/$defs/service" } } } },
    { "if": { "properties": { "type": { "const": "infrastructure" } }, "required": ["type"] }, "then": { "properties": { "details": { "$ref": "#/$defs/infrastructure" } } } },
    { "if": { "properties": { "type": { "const": "background-worker" } }, "required": ["type"] }, "then": { "properties": { "details": { "$ref": "#/$defs/backgroundWorker" } } } }
  ],
  "$defs": {
    "string": { "type": "string", "minLength": 1, "maxLength": 50, "pattern": "^[A-Za-z0-9 ._()@+:/#&',%\\[\\]-]+$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^[A-Za-z0-9 ._()@+:/#&',%\\[\\]-]+$" },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "api_type", "network_exposure"],
      "properties": {
        "name": { "$ref": "#/$defs/string" },
        "api_type": { "type": "string", "maxLength": 50, "enum": ["rest", "graphql", "grpc", "json-rpc", "soap", "websocket", "odata", "sse", "event", "topic", "exchange", "queue", "native-protocol"] },
        "network_exposure": { "type": "string", "maxLength": 50, "enum": ["internal", "internet"] }
      }
    },
    "service": { "type": "object", "additionalProperties": false, "required": ["language"], "properties": { "language": { "$ref": "#/$defs/string" }, "language_version": { "$ref": "#/$defs/string" }, "framework": { "$ref": "#/$defs/string" } } },
    "backgroundWorker": { "type": "object", "additionalProperties": false, "required": ["language", "broker"], "properties": { "language": { "$ref": "#/$defs/string" }, "language_version": { "$ref": "#/$defs/string" }, "framework": { "$ref": "#/$defs/string" }, "broker": { "type": "string", "maxLength": 50, "enum": ["rabbitmq", "kafka", "redpanda", "nats-jetstream", "apache-pulsar", "aws-sqs", "google-cloud-pub-sub", "azure-service-bus", "redis-streams", "activemq", "ibm-mq"] } } },
    "infrastructure": { "type": "object", "additionalProperties": false, "required": ["system", "system_type"], "properties": { "system": { "$ref": "#/$defs/string" }, "system_type": {"type": "string", "maxLength": 50, "enum": ["queue/stream", "sql-database", "nosql-database", "workflow-engine"]}, "version": { "$ref": "#/$defs/string" }, "network_address": {"type": ["array", "null"], "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 50, "pattern": "^[A-Za-z0-9 ._()@+:/#&',%\\[\\]-]+$"}} } }
  }
}
