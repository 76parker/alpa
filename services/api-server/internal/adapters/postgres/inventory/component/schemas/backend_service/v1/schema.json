{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BackendServiceDetailsV1",
  "description": "Version 1 details for a backend service component.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "core_language"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "core_language": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9 ._()@+:/#&',%\\[\\]-]+$",
      "maxLength": 50
    },
    "language_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9 ._()@+:/#&',%\\[\\]-]+$",
      "maxLength": 50
    },
    "main_framework": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9 ._()@+:/#&',%\\[\\]-]+$",
      "maxLength": 50
    }
  }
}
