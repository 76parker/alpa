{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InfrastructureDetailsV1",
  "description": "Version 1 details for an infrastructure component.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "technology_name",
    "technology_type",
    "importancy",
    "endpoints"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "technology_name": {
      "type": "string",
      "maxLength": 50,
      "enum": [
        "postgresql",
        "mysql",
        "mariadb",
        "mongodb",
        "cassandra",
        "clickhouse",
        "redis",
        "memcached",
        "etcd",
        "kafka",
        "rabbitmq",
        "nats",
        "pulsar",
        "elasticsearch",
        "opensearch",
        "s3",
        "minio",
        "ceph",
        "temporal",
        "airflow",
        "argo-workflows",
        "nginx",
        "envoy",
        "kong",
        "traefik",
        "haproxy",
        "prometheus",
        "grafana",
        "zabbix",
        "jaeger",
        "zipkin",
        "opentelemetry",
        "keycloak",
        "vault"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9 ._()@+:/#&',%\\[\\]-]+$",
      "maxLength": 50
    },
    "endpoints": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50,
        "pattern": "^[A-Za-z0-9 ._()@+:/#&',%\\[\\]-]+$"
      }
    },
    "technology_type": {
      "type": "string",
      "maxLength": 50,
      "enum": [
        "message-broker",
        "sql-database",
        "nosql-database",
        "cache",
        "search-engine",
        "object-storage",
        "workflow-engine",
        "service-mesh",
        "api-gateway",
        "load-balancer",
        "identity-provider",
        "secret-storage",
        "monitoring",
        "logging",
        "tracing"
      ]
    },
    "importancy": {
      "type": "string",
      "enum": [
        "critical",
        "important",
        "supporting"
      ]
    }
  }
}
