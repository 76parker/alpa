{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InfrastructureDetailsV1",
  "description": "Version 1 details for an infrastructure component.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "system"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "system": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9 ._()@+:/#&',%\\[\\]-]+$",
      "maxLength": 50
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9 ._()@+:/#&',%\\[\\]-]+$",
      "maxLength": 50
    },
    "network_address": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9 ._()@+:/#&',%\\[\\]-]+$",
      "maxLength": 50
    }
  }
}
