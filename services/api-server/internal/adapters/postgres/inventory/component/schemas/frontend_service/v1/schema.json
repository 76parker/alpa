{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrontendServiceDetailsV1",
  "description": "Version 1 details for a frontend service component.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "core_language"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "core_language": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "enum": [
        "c", "c++", "c#", "go", "java", "javascript", "typescript", "python", "ruby", "php", "rust", "swift", "kotlin", "scala", "dart", "lua", "perl", "r", "objective-c", "shell", "bash", "powershell", "sql", "solidity", "haskell", "elixir", "erlang", "clojure", "groovy", "fortran", "cobol", "assembly", "visual-basic", "matlab", "pascal", "delphi", "f#", "julia", "zig", "nim", "ocaml", "prolog", "common-lisp", "scratch"
      ]
    },
    "language_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "main_framework": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    }
  }
}
