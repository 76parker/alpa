    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "elkjs": "^0.11.0",
    "lucide-react": "latest",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.71.2",
